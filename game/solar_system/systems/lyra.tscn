[node name="Cinder" type="Node3D" parent="." unique_id=1276197841]
script = ExtResource("2_planet")
display_name = "Cinder"
radius = 0.4
orbit_radius = 8.8
orbit_period = 120.0
start_angle = 270.0
spin_period = 22.0
surface_material = SubResource("ShaderMaterial_cinder")
icon_color = Color(0.949, 0.651, 0.353, 1)
fuel_price = 0.14
tagline = "Glassworks on the day side"
lore = "Cinder is too close to Lyra to be comfortable and too rich in sand to leave alone. Its glassblowers work through the long noon behind mirrored shutters, and every window in the system was made here."
orbit_material = SubResource("StandardMaterial3D_orbit")

[node name="Janus" type="Node3D" parent="Cinder" unique_id=1295435038]
script = ExtResource("2_planet")
display_name = "Janus"
radius = 0.22
orbit_radius = 4.0
orbit_period = 50.0
spin_period = 0.0
surface_material = SubResource("ShaderMaterial_pip")
icon_color = Color(0.933, 0.965, 1, 1)
fuel_price = 0.16
tagline = "Scorched, then frozen"
lore = "Every orbit, Janus swings in close enough to Lyra to blister its paint, then out past Cinder into a frost that cracks it. Its one town packs up twice a turn, and the locals judge a bus driver entirely by which half of the year they arrive in."
orbit_width = 0.03
orbit_material = SubResource("StandardMaterial3D_orbit")

[node name="Hither" type="Node3D" parent="." unique_id=1580065921]
script = ExtResource("2_planet")
display_name = "Hither"
radius = 0.55
orbit_radius = 21.0
orbit_period = 310.0
