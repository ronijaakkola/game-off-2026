icon_color = Color(1, 0.561, 0.659, 1)
fuel_price = 0.08
tagline = "Always over there"
lore = "Yon shares Hither's orbit and has never once come closer. The two towns signal each other across the star every evening, and argue, slowly and with great affection, about which of them is the far one."
show_orbit = false
orbit_material = SubResource("StandardMaterial3D_orbit")

