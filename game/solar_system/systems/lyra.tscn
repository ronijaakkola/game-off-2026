spin_period = 30.0
tilt = 12.0
surface_material = SubResource("ShaderMaterial_verdance")
icon_color = Color(0.416, 0.82, 0.627, 1)
fuel_price = 0.11
has_lab = true
tagline = "Gardens, and a view of Yon"
lore = "Hither grows the food for the whole of Lyra in terraced valleys, and looks across the star at Yon, its twin on the same orbit, which it will never catch. The depot here is new and very proud of its timetable, which it reprints every week whether anything changed or not."
orbit_material = SubResource("StandardMaterial3D_orbit")

[node name="Yon" type="Node3D" parent="." unique_id=435197784]
