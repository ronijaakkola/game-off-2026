script = ExtResource("1_system")
display_name = "Sol"
music = ExtResource("90_music")
home = NodePath("Mars")
bounds_radius = 22.0
max_distance = 62.0
arrival_call = "Welcome to Sol. The sun here is dying, and Earth was abandoned long ago. The planets that are left still need a bus. Get to work."
mechanic_call = "Last shipment, and the best I've got. The lab has the final upgrades in every tree. And kid, watch the sun: it's old and restless. When it starts throbbing, its heat swells right out to Jupiter. Look, it's starting now!"
