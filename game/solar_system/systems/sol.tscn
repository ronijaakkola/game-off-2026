tagline = "Where every route begins"
lore = "The old orbital yards over Terra built the first frameshift buses, and the depot still keeps their timetables. Half the system calls it home, and the other half is visiting relatives. A bus here is expected on time, to the second."
orbit_material = SubResource("StandardMaterial3D_orbit")

