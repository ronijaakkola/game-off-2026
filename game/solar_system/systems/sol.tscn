tagline = "Towns that chase the dusk"
lore = "Ember turns slowly, close to the star, and its towns roll along the dusk line to stay out of the noon heat. Everyone here is always on the move, and most of them would rather someone else did the driving."
orbit_material = SubResource("StandardMaterial3D_orbit")

