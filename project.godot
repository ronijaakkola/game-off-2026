; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Jam Boilerplate"
config/version="0.1.0"
run/main_scene="res://ui/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="res://core/audio/default_bus_layout.tres"

[autoload]

LimboConsole="*res://addons/limbo_console/limbo_console.gd"
Events="*res://core/events/events.gd"
Audio="*res://core/audio/audio.gd"
Settings="*res://core/settings/settings.gd"
SceneFlow="*res://core/scene_flow/scene_flow.gd"
Feedback="*res://core/feedback/feedback.gd"
Talo="*uid://bpmdn8oc34pg7"
Online="*res://core/online/online.gd"
DevConsole="*res://core/dev_console/dev_console.gd"
DebugPanel="*res://core/debug_panel/debug_panel.tscn"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/limbo_console/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/talo/plugin.cfg")

[gdunit4]

report/godot/push_error=true
settings/test/test_discovery=true
ui/toolbar/run_overall=true

[gui]

common/snap_controls_to_pixels=false

