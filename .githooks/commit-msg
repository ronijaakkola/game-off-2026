#!/bin/sh
# Reject commit messages that don't follow Conventional Commits.
# https://www.conventionalcommits.org/en/v1.0.0/

subject=$(grep -v '^#' "$1" | head -n 1)
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if echo "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

# Allow autosquash prefixes; they are squashed away before merging.
if echo "$subject" | grep -Eq '^(fixup|squash|amend)! '; then
  exit 0
fi

cat >&2 <<MSG
commit-msg: subject is not a Conventional Commit:

  $subject

Expected: <type>(<optional scope>)!: <description>
Types: feat fix docs style refactor perf test build ci chore revert
Example: feat(player): add double jump
MSG
exit 1
