{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(uv run tools/check.py:*)",
      "Bash(uv run tools/blender.py:*)",
      "Bash(bash tools/cloud_setup.sh)"
    ],
    "deny": [
      "Edit(/addons/gdUnit4/**)",
      "Edit(/addons/limbo_console/**)",
      "Edit(/addons/talo/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/tools/cloud_session_start.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "uv run \"$CLAUDE_PROJECT_DIR/tools/check.py\" lint --hook" }
        ]
      }
    ]
  }
}
